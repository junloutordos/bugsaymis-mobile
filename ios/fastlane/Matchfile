git_url("git@github.com:junloutordos/bugsaymis-mobile-certificates.git")

storage_mode("git")

type("development") # The default type, can be: appstore, adhoc, enterprise or development

# This machine's system Ruby/OpenSSL combo fails GCM encryption with
# "couldn't set additional authenticated data" (a known fastlane/match
# issue on some OpenSSL builds). Legacy (CBC) encryption avoids that
# codepath. Must stay in sync with the `force_legacy_encryption:` value
# passed to `match()` in ios/fastlane/Fastfile, since CI decrypts with
# whatever scheme this repo was actually encrypted with.
force_legacy_encryption(true)

