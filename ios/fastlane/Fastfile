default_platform(:ios)

platform :ios do
  desc "Build, sign via match, and upload AtlasGo to TestFlight"
  lane :release do
    build_name = ENV.fetch("BUILD_NAME") { UI.user_error!("BUILD_NAME env var is required") }
    build_number = ENV.fetch("BUILD_NUMBER") { UI.user_error!("BUILD_NUMBER env var is required") }

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true
    )

    match(
      type: "appstore",
      readonly: true,
      api_key: api_key,
      git_url: "git@github.com:junloutordos/bugsaymis-mobile-certificates.git",
      force_legacy_encryption: true
    )

    # A subprocess spawned via fastlane's sh() from inside `bundle exec`
    # inherits Bundler's GEM_HOME/GEM_PATH/BUNDLE_GEMFILE — so a Ruby-based
    # tool like `pod`, invoked here as a subprocess, tries to resolve against
    # fastlane's own bundle sandbox instead of its real gem install and
    # reports itself broken. Bundler.with_original_env strips that leaked
    # environment before shelling out, matching the plain (non-bundled)
    # GitHub Actions steps where this exact build already works fine.
    Bundler.with_original_env do
      sh(
        "flutter", "build", "ios",
        "--release",
        "--no-codesign",
        "--build-name=#{build_name}",
        "--build-number=#{build_number}",
        chdir: ".."
      )
    end

    # The Xcode project has a hardcoded provisioning profile specifier
    # ("AtlasGo App Store") that doesn't match match's dynamically-named
    # profile. That mismatch breaks the *archive* step (xcodebuild reads it
    # straight from the pbxproj), so it must be patched before build_app
    # runs — passing export_options to build_app alone only affects the
    # later export-to-IPA step, not the archive.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]["ph.edu.pshs.crc.bugsaymisMobile"],
      team_id: ENV["APPLE_TEAM_ID"],
      targets: "Runner"
    )

    # xcodebuild's own "Run Script" build phase re-invokes Flutter tooling
    # internally (Flutter's xcode_backend.sh). That nested Flutter call hangs
    # indefinitely (not a clean error, confirmed reproducible even with
    # Bundler.with_original_env applied here too) specifically during the
    # *archive* action, never during a plain `build` action (which is what
    # the flutter build ios step above already does successfully). Xcode's
    # newer "User Script Sandboxing" (stricter for Archive than Build, and
    # new territory since switching this job to macos-15/Xcode 16) can
    # silently block things a script needs — e.g. network access — causing a
    # hang rather than a clean rejection. Disabling it targets that directly.
    Bundler.with_original_env do
      build_app(
        workspace: "Runner.xcworkspace",
        scheme: "Runner",
        export_method: "app-store",
        output_directory: "../build/ios/ipa",
        xcargs: "ENABLE_USER_SCRIPT_SANDBOXING=NO",
        export_options: {
          provisioningProfiles: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
        }
      )
    end

    # Retry briefly: the exported .ipa can appear on disk a beat after gym's
    # "Successfully exported" log line — a real race hit once during manual
    # local testing (file existed moments later; a bare Dir.glob missed it).
    ipa_path = nil
    10.times do
      ipa_path = Dir.glob("../build/ios/ipa/*.ipa").first
      break if ipa_path
      sleep 1
    end
    UI.user_error!("No .ipa found under build/ios/ipa") unless ipa_path

    upload_to_testflight(
      ipa: ipa_path,
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
